{
  "$description": "Dubai Font for both scripts, as one web family (\"Dubai W23\") with real weights 400, 500 and 700 (Light is dropped: no role uses it, decision A3). Latin and Arabic are separate subset files under one family; Arabic contexts put the Arabic face first (\"Dubai W23 Arabic\", the same files) so spaces, digits and punctuation in Arabic text come from the Arabic file and an Arabic page does not download the Latin file. \"Dubai W23 Fallback\" is a metric-matched local face (Arial for Latin, Tahoma for Arabic) so the swap does not move text. Material-style scale: Arabic roles run one step larger with taller leading, never letter-spaced and never below 16px. Leading is tighter than direction E drew it (user preference: Dubai Font looks better set tight). Line height is authored in px ($extensions.lineHeightPx); lineHeight is the same value as a ratio.",
  "font": {
    "family": {
      "latin": {
        "$type": "fontFamily",
        "$value": [
          "Dubai W23",
          "Dubai W23 Fallback",
          "system-ui",
          "sans-serif"
        ],
        "$description": "English and every non-Arabic language"
      },
      "arabic": {
        "$type": "fontFamily",
        "$value": [
          "Dubai W23 Arabic",
          "Dubai W23",
          "Dubai W23 Fallback",
          "system-ui",
          "sans-serif"
        ],
        "$description": "lang=\"ar\": the Arabic file first, so Arabic text with spaces, digits and punctuation needs only the Arabic file; Latin letters fall through to the Latin file"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
